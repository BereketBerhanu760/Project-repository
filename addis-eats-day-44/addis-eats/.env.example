# Required in production; use a unique random secret of at least 32 characters.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Server-only JSON account list. Replace both placeholder passwords before deployment.
AUTH_USERS='[{"username":"customer","password":"replace-with-a-12-character-password","role":"customer"},{"username":"staff","password":"replace-with-another-12-character-password","role":"staff"}]'

# Optional Upstash Redis REST credentials for durable serverless persistence:
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
