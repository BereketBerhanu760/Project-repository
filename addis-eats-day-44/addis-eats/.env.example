# Required in production; use a unique random secret of at least 32 characters.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Replace dummy credentials with server-only account credentials before production.
AUTH_USERS='[{"username":"customer","password":"replace-with-a-12-character-password","role":"customer"}]'

# Optional Upstash Redis REST credentials for durable serverless persistence:
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
